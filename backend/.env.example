# Variables del backend. Copie este archivo a .env (ignorado por git) para desarrollo local
# y configure las mismas en Render > Environment para producción.

# --- Base de datos (Supabase) ---
DB_URL=jdbc:postgresql://<host-del-pooler>:5432/postgres?sslmode=require
DB_USERNAME=<usuario>
DB_PASSWORD=<contraseña>

# --- CORS: origen del frontend (con el rewrite de Vercel solo se usa si se llama a la API directo) ---
FRONTEND_URL=https://pricing-dinamico.vercel.app

# --- Autenticación (obligatorias) ---
# Clave para firmar los JWT, mínimo 32 caracteres. Genérela con: openssl rand -base64 48
JWT_SECRET=<clave-aleatoria>
# Contraseñas de los usuarios iniciales (mínimo 8 caracteres). Si cambian, se actualizan al reiniciar.
ADMIN_PASSWORD=<contraseña-admin>
ANALISTA_PASSWORD=<contraseña-analista>

# --- Autenticación (opcionales; estos son los valores por defecto) ---
# AUTH_IDLE_TIMEOUT=15m
# AUTH_ACCESS_TOKEN_TTL=10m
# AUTH_SESSION_MAX_DURATION=8h
# Solo si el frontend llama a la API desde otro dominio sin el rewrite de Vercel:
# AUTH_COOKIE_SAME_SITE=None
# En local sin HTTPS fuera de localhost:
# AUTH_COOKIE_SECURE=false
